# Address the HTTP listener binds to. A TLS-terminating reverse proxy in front
# of this maps the console's account domain to it.
PN_ACCOUNT_HTTP_LISTEN=:8080

# The real NNAS provider. Every request that is not a nex_token / service_token
# exchange for a configured game server is proxied here unchanged.
PN_ACCOUNT_UPSTREAM=https://account.pretendo.cc

# Optional PEM client certificate presented to the upstream. Pretendo behind
# Cloudflare gates Wii U traffic on the console common certificate. Set both or
# neither. Never commit these files.
#PN_ACCOUNT_CLIENT_CERT=/run/secrets/wiiu-common-client-cert.pem
#PN_ACCOUNT_CLIENT_KEY=/run/secrets/wiiu-common-client-key.pem

# 32-byte AES-256 key used to sign NEX tokens. Must match the key the target
# NEX servers validate with. Generate with: openssl rand -hex 32
PN_NEX_TOKEN_AES_KEY=CHANGE_ME_64_HEX_CHARACTERS

# >= 32-byte HMAC secret used to derive the per-PID NEX password. Must match the
# secret the target NEX servers use. Generate with: openssl rand -hex 32
PN_NEX_PASSWORD_SECRET=CHANGE_ME_64_HEX_CHARACTERS

# Game servers this account server issues local nex_token responses for.
# One entry per line or ';'-separated:  <game_server_id>=<host>:<auth_port>[:<title,title,...>]
# The optional title list restricts which X-Nintendo-Title-ID may use that ID.
PN_GAME_SERVERS=1012f100=nex.example.org:25000:000500001012f100,0005000010144d00,0005000010144e00

# Alternative JSON form of the same setting (takes precedence if it starts with '{'):
#PN_GAME_SERVERS={"1012f100":{"host":"nex.example.org","auth_port":25000,"titles":["000500001012f100"]}}

# Comma-separated client_id values allowed to receive a locally signed
# service_token. Leave empty to disable the service_token endpoint.
PN_SERVICE_TOKEN_CLIENT_IDS=
